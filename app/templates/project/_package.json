{
  "name": "<%= opts.projectSlug %>",
  "title": "<%= opts.projectName %>",
  "version": "0.1.0",
  "description": "<%= opts.description %>",
  "keywords": [
    "generator-themeplate",
    "wordpress",
    "theme"
  ],
  "homepage": "<%= opts.projectURI %>",
  "license": "<%= opts.license %>",
  "private": true,
  "author": {
    "name": "<%= opts.authorName %>",
    "email": "<%= opts.authorEmail %>",
    "url": "<%= opts.authorURI %>"
  },
  "main": "style.css",
  "engines": {
    "node": "^16.13.0 || >=18.12.0"
  },
  "browserslist": [
    "> 0.1%",
    "last 2 versions",
    "not dead"
  ],
  "scripts": {
    "lint": "run-p lint:* --continue-on-error",
    "lint:scripts": "eslint src/js/",
    "lint:styles": "stylelint src/sass/",
    "fix": "run-p fix:* --continue-on-error",
    "fix:scripts": "eslint src/js/ --fix",
    "fix:styles": "stylelint src/sass/ --fix"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-typescript": "^7.26.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.23.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/browser-sync": "^2.29.0",
    "@types/gulp": "^4.0.17",
    "@types/gulp-load-plugins": "^0.0.37",
    "@types/minimist": "^1.2.5",
    "@types/vinyl": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^8.27.0",
    "@typescript-eslint/parser": "^8.27.0",
    "@wordpress/eslint-plugin": "^22.6.0",
    "@wordpress/stylelint-config": "^23.12.0",
    "autoprefixer": "^10.4.21",
    "browser-sync": "^3.0.3",
    "cssnano": "^7.0.6",
    "eslint": "^8.57.1",
    "genetiks": "^2.1.0",
    "gulp": "^5.0.0",
    "gulp-bump": "^3.2.0",
    "gulp-header": "^2.0.9",
    "gulp-imagemin": "~7.1.0",
    "gulp-load-plugins": "^2.0.8",
    "gulp-notify": "^5.0.0",
    "gulp-plumber": "^1.2.1",
    "gulp-postcss": "^10.0.0",
    "gulp-rename": "^2.0.0",
    "gulp-rollup-each": "^4.0.1",
    "gulp-sass": "^6.0.1",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-uglify": "^3.0.2",
    "gulp-webp": "~4.0.1",
    "minimist": "^1.2.8",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "rollup": "^4.36.0",
    "sass": "^1.86.0",
    "stylelint": "^16.16.0",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "vinyl": "^3.0.0"
  }
}
